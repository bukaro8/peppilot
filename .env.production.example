# Copy to .env.production.local for local validation only.
# Mark only the secret values identified in the deployment guide as Coolify secrets.
# Never commit real secret values.
POSTGRES_DB=peppilot
POSTGRES_USER=peppilot
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://peppilot:replace-with-a-url-encoded-strong-password@database:5432/peppilot

# Generate a high-entropy secret and store it only in Coolify.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://protocols.weightpilot.uk

# Resend SMTP. SMTP_PASSWORD is the Resend API key and must be a Coolify secret.
EMAIL_FROM=PepPilot <noreply@weightpilot.uk>
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=replace-with-resend-api-key
