# Local Docker development only. Use separate credentials in production.
POSTGRES_DB=peppilot
POSTGRES_USER=peppilot
POSTGRES_PASSWORD=peppilot_dev_only

# Used when running Drizzle commands directly on the host.
# Docker Compose replaces the hostname with the database service name for the app container.
DATABASE_URL=postgresql://peppilot:peppilot_dev_only@localhost:5432/peppilot

# Passwordless authentication. Replace the development secret if this file is used outside Docker.
BETTER_AUTH_SECRET=peppilot-local-auth-secret-change-before-production
BETTER_AUTH_URL=http://localhost:3000

# Local Docker sends sign-in email to Mailpit at http://localhost:8025.
EMAIL_FROM=PepPilot <no-reply@peppilot.local>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
